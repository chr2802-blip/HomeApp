# Postgres connection string used at runtime.
# On a serverless host (Neon, Supabase, Vercel Postgres) use the POOLED connection here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Unpooled/direct connection, used only for migrations. Locally this is the same as
# DATABASE_URL; on Neon it is the connection string WITHOUT "-pooler" in the host.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random 32+ character string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Web Push keys. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret the reminder cron endpoint requires as "Authorization: Bearer <value>".
# On Vercel, set this and the platform sends it automatically on scheduled runs.
CRON_SECRET=""

# Optional. Lets a cook-mode timer ring as a push notification when the phone is locked or
# the app is closed: starting a timer asks QStash (upstash.com) to call
# /api/cook-timers/ring at the timer's end. All three are on the QStash page of the
# Upstash console. Without them the timers count and buzz in the page only. QStash has to
# reach this app over the internet, so it is set on the deployment, not on a laptop.
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Only where the console names a regional QStash address; the SDK reads it itself.
# QSTASH_URL=""
# Optional. The public address QStash calls back on. Defaults to the production address
# Vercel names (VERCEL_PROJECT_PRODUCTION_URL), then to the request's own origin.
APP_URL=""

# Optional. `npm run db:check` replays the migrations into a throwaway database to
# compare them against the schema; by default it derives one by suffixing DATABASE_URL's
# name with "_shadow". Set this to point it elsewhere. Prisma drops and rebuilds whatever
# it points at, so it must never be a database holding real data.
SHADOW_DATABASE_URL=""

# Only needed when running `npm run db:seed` to create the first super admin.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Super admin"

# Database calls slower than this (milliseconds) are recorded and shown on the
# System page. Optional; defaults to 400.
SLOW_QUERY_MS="400"

# Reads an imported recipe. The importer extracts the text of a page or a reel's
# description and then hands it to Claude to turn into a recipe; without this key it
# refuses the import and offers the create form instead. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=""
