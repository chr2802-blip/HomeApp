#!/bin/sh
#
# Pushing to GitHub is what triggers a Vercel deploy, so the checks run here.
#
# What runs depends on what changed. Lint, types and the unit tests always run — they
# need nothing and take seconds. The integration and browser suites need Postgres and a
# production build, so they run only when something they could possibly exercise has
# changed. Editing a README should not cost three minutes and a Next.js build.
#
# When in doubt this runs everything: an unrecognised push, no range to compare, or any
# change outside the known-safe set. CI runs the full suite on the server regardless, so
# the worst case here is finding out a minute later rather than a minute earlier.
#
# To push anyway in an emergency: git push --no-verify

set -e

ZERO=0000000000000000000000000000000000000000

# Paths where a change could affect the app itself, its tests, or how either is built.
CODE_PATHS='^(src/|prisma/|tests/|e2e/|scripts/|package\.json|package-lock\.json|tsconfig\.json|(next|vitest|playwright|postcss|eslint)\.config\.[a-z]+)'

changed=""
saw_range=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a branch pushes no content.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # A new branch: compare against where it left the default branch.
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  if [ -z "$base" ]; then
    saw_range=0
    break
  fi

  changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  saw_range=1
done

needs_everything=1
if [ "$saw_range" = "1" ] && [ -n "$(printf %s "$changed" | tr -d '[:space:]')" ]; then
  if printf %s "$changed" | grep -qE "$CODE_PATHS"; then
    needs_everything=1
  else
    needs_everything=0
  fi
fi

run() {
  echo "pre-push: $1"
  shift
  if ! "$@"; then
    echo ""
    echo "pre-push: FAILED — nothing was pushed, so nothing will deploy."
    echo "  Integration and browser tests need the local Postgres running:"
    echo "    docker start homehub-pg"
    echo "  Re-run everything with: npm run verify"
    echo "  Browser failures leave a report: npm run e2e:report"
    exit 1
  fi
}

run "checking lint and types..." npm run --silent lint
run "" npm run --silent typecheck
run "running unit tests..." npm run --silent test:unit

if [ "$needs_everything" = "1" ]; then
  run "running integration tests..." npm run --silent test:integration
  run "running browser tests..." npm run --silent e2e
else
  echo "pre-push: no application, test or build files changed — skipping the"
  echo "          integration and browser suites. CI still runs them in full."
fi

echo "pre-push: all checks passed."
