#!/bin/sh
#
# Pushing to GitHub is what triggers a Vercel deploy, so the checks run here.
#
# What runs depends on what changed. Lint, types and the unit tests always run — they
# need nothing and take seconds. The schema check, the integration suite and the browser
# suite need Postgres and a production build, so they run only when something they could
# possibly exercise has changed. Editing a README should not cost three minutes and a
# Next.js build.
#
# When in doubt this runs everything: an unrecognised push, no range to compare, or any
# change outside the known-safe set. Nothing runs after this: there is no CI, and the
# Vercel build runs no tests, so what this lets through is what deploys.
#
# To push anyway in an emergency: git push --no-verify

set -e

# The only test gate: there is no CI and the Vercel build runs no tests. This makes both
# suites refuse a stray `it.only`/`test.only`, which would otherwise read as a pass.
export TEST_GATE=1

ZERO=0000000000000000000000000000000000000000

# Paths where a change could affect the app itself, its tests, or how either is built.
CODE_PATHS='^(src/|prisma/|tests/|e2e/|scripts/|package\.json|package-lock\.json|tsconfig\.json|(next|vitest|playwright|postcss|eslint)\.config\.[a-z]+)'

changed=""
saw_range=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a branch pushes no content.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # A new branch: compare against where it left the default branch.
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  if [ -z "$base" ]; then
    saw_range=0
    break
  fi

  changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  saw_range=1
done

needs_everything=1
if [ "$saw_range" = "1" ] && [ -n "$(printf %s "$changed" | tr -d '[:space:]')" ]; then
  if printf %s "$changed" | grep -qE "$CODE_PATHS"; then
    needs_everything=1
  else
    needs_everything=0
  fi
fi

# How much of the browser suite runs is the pusher's judgement of the change's risk,
# given as RISK=low|medium|high (see CLAUDE.md, "How much of the browser suite runs"):
#   low    — none of it
#   medium — the tests tagged @smoke, the flows that would hurt most if broken
#   high   — all of it
# Unset means high: somebody who has not said is somebody who has not judged. And a change
# to what the whole app stands on is high whatever it was called, because the smoke tests
# cannot be trusted to cover it.
ALWAYS_HIGH='^(prisma/|package\.json|package-lock\.json|e2e/helpers/|(next|playwright)\.config\.[a-z]+|public/sw\.js|src/middleware\.ts|src/lib/(home-db|access|auth|scoped)\.ts)'

risk=$(printf %s "${RISK:-high}" | tr '[:upper:]' '[:lower:]')
case "$risk" in
  low|medium|high) ;;
  *)
    echo "pre-push: RISK must be low, medium or high, not \"$RISK\". Nothing was pushed."
    exit 1
    ;;
esac
if [ "$risk" != "high" ] && printf %s "$changed" | grep -qE "$ALWAYS_HIGH"; then
  echo "pre-push: RISK=$risk raised to high — the change touches:"
  printf %s "$changed" | grep -E "$ALWAYS_HIGH" | sort -u | sed 's/^/            /'
  risk=high
fi
# An unrecognised push has no list of changes to judge, so it is high too.
[ "$saw_range" = "1" ] || risk=high

run() {
  echo "pre-push: $1"
  shift
  if ! "$@"; then
    echo ""
    echo "pre-push: FAILED — nothing was pushed, so nothing will deploy."
    echo "  Integration and browser tests need the local Postgres running:"
    echo "    docker start homehub-pg"
    echo "  Re-run everything with: npm run verify"
    echo "  Browser failures leave a report: npm run e2e:report"
    exit 1
  fi
}

run "checking lint and types..." npm run --silent lint
run "" npm run --silent typecheck
run "running unit tests..." npm run --silent test:unit

if [ "$needs_everything" = "1" ]; then
  # First, because it takes two seconds and the alternative to finding out here is a
  # failed production build with no rollback: migrations run inside that build, so a
  # schema edited without a migration to match deploys nothing and cannot be undone.
  run "checking migrations match the schema..." npm run --silent db:check
  run "running integration tests..." npm run --silent test:integration
  case "$risk" in
    low) echo "pre-push: RISK=low — skipping the browser suite." ;;
    medium) run "running the browser smoke tests (RISK=medium)..." npm run --silent e2e:smoke ;;
    high) run "running browser tests (RISK=high)..." npm run --silent e2e ;;
  esac
else
  echo "pre-push: no application, test or build files changed — skipping the"
  echo "          integration and browser suites."
fi

echo "pre-push: all checks passed."
