#!/bin/sh
#
# A fast check before the push, not the gate.
#
# The gate is CI. A ruleset on `main` requires a pull request and a green
# "Lint, types and tests" before anything can merge, so nothing reaches the deploy
# without the full suite having passed on the server. This hook exists to catch the
# ordinary mistake in seconds rather than in a five-minute round trip — which is a
# different job, and a much cheaper one.
#
# It used to be the only thing standing between a mistake and production, because
# pushing to `main` deployed and nothing checked the push. That is why it ran a
# production build and the whole browser suite on every change to src/, and why every
# push cost minutes. With the ruleset in place that work is duplicated, and duplicated
# in the slower of the two places.
#
# So: lint, types and the unit tests always, because they need nothing and take
# seconds. The schema check when the schema moved, because a bad migration is the one
# failure with no rollback and asking costs two seconds. The integration and browser
# suites belong to CI now.
#
# Run everything locally yourself with: npm run verify
# To skip this hook in a hurry: git push --no-verify
#   (the ruleset still holds — an unmergeable PR is the worst you can do)

set -e

ZERO=0000000000000000000000000000000000000000

# Where a change could alter the database schema, and so the migrations that ship with
# it. Narrower than the old set on purpose: this now guards one specific failure.
SCHEMA_PATHS='^prisma/'

changed=""
saw_range=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a branch pushes no content.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    # A new branch: compare against where it left the default branch.
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
  else
    base="$remote_sha"
  fi

  if [ -z "$base" ]; then
    saw_range=0
    break
  fi

  changed="$changed
$(git diff --name-only "$base" "$local_sha")"
  saw_range=1
done

# When in doubt, check: an unrecognised push or no range to compare against is worth
# two seconds rather than a guess.
needs_schema_check=1
if [ "$saw_range" = "1" ] && [ -n "$(printf %s "$changed" | tr -d '[:space:]')" ]; then
  if printf %s "$changed" | grep -qE "$SCHEMA_PATHS"; then
    needs_schema_check=1
  else
    needs_schema_check=0
  fi
fi

run() {
  echo "pre-push: $1"
  shift
  if ! "$@"; then
    echo ""
    echo "pre-push: FAILED — nothing was pushed."
    echo "  The schema check needs the local Postgres running:"
    echo "    docker start homehub-pg"
    echo "  Run the full suite the way CI does: npm run verify"
    exit 1
  fi
}

run "checking lint and types..." npm run --silent lint
run "" npm run --silent typecheck
run "running unit tests..." npm run --silent test:unit

if [ "$needs_schema_check" = "1" ]; then
  # Two seconds, and the alternative to finding out here is a failed production build
  # with no rollback: migrations run inside that build, so a schema edited without a
  # migration to match deploys nothing and cannot be undone. CI checks this too, but
  # this is the one failure worth catching before it is ever pushed.
  run "checking migrations match the schema..." npm run --silent db:check
fi

echo "pre-push: passed. CI runs the integration and browser suites, and the ruleset"
echo "          on main will not let a red pull request merge."
