generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used at runtime by serverless functions.
  url       = env("DATABASE_URL")
  // Unpooled connection; migrations need a direct session. Locally both are the same.
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model Home {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  users   User[]
  invites Invite[]
  lists   List[]
  tasks   RecurringTask[]
  recipes Recipe[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  homeId       String?
  createdAt    DateTime @default(now())

  home              Home?              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscription[]
  lists             List[]
  tasks             RecurringTask[]
  recipes           Recipe[]
  invitesCreated    Invite[]           @relation("InviteCreatedBy")

  @@index([homeId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  homeId      String
  role        Role      @default(USER)
  codeHash    String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy User @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([email])
}

model List {
  id           String   @id @default(cuid())
  homeId       String
  title        String
  /// Whether items on this list carry a quantity. Chosen when the list is made: a
  /// shopping list wants "2 milk", a to-do list does not.
  trackAmounts Boolean  @default(false)
  createdById  String
  createdAt    DateTime @default(now())

  home      Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items     ListItem[]

  @@index([homeId])
}

model ListItem {
  id       String  @id @default(cuid())
  listId   String
  text     String
  amount   Int     @default(1)
  done     Boolean @default(false)
  position Int     @default(0)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

model RecurringTask {
  id              String    @id @default(cuid())
  homeId          String
  title           String
  notes           String?
  intervalDays    Int
  nextDueAt       DateTime
  lastCompletedAt DateTime?
  lastNotifiedAt  DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([nextDueAt])
  // The dashboard and the task list both ask for one home's tasks in due order.
  @@index([homeId, nextDueAt])
}

model Recipe {
  id           String   @id @default(cuid())
  homeId       String
  title        String
  description  String?
  ingredients  String   @default("")
  instructions String   @default("")
  videoUrl     String?
  createdById  String
  createdAt    DateTime @default(now())

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([homeId])
}

/**
 * Failed sign-in and invite attempts, used only for throttling.
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/**
 * One row per reminder run. Without this a cron that silently stops running looks
 * exactly like a week with nothing due, and nobody finds out.
 */
model CronRun {
  id                String    @id @default(cuid())
  job               String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  ok                Boolean   @default(false)
  tasksDue          Int       @default(0)
  notificationsSent Int       @default(0)
  error             String?

  @@index([job, startedAt])
}

/**
 * Database calls that took longer than the threshold. Only the slow ones are kept:
 * recording every query would make the metrics table the busiest one in the database.
 */
model SlowQuery {
  id         String   @id @default(cuid())
  model      String?
  operation  String
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
