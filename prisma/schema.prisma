generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used at runtime by serverless functions.
  url       = env("DATABASE_URL")
  // Unpooled connection; migrations need a direct session. Locally both are the same.
  directUrl = env("DIRECT_URL")
}

/**
 * What somebody may do across the whole installation, which is now the one question:
 * are they the super admin who looks after every household, or an ordinary person?
 *
 * Being an admin is no longer answered here. It is answered per home, on HomeMember,
 * because somebody can run one household and merely live in another.
 */
enum PlatformRole {
  SUPER_ADMIN
  USER
}

/// What somebody may do inside one home they belong to.
enum MemberRole {
  ADMIN
  USER
}

/**
 * The colour a home is dressed in, so the household on screen is known at a glance
 * rather than read off the header.
 *
 * A fixed set rather than a colour of one's own: every one of these is checked against
 * white text and against the page behind it, and a free choice is a household one
 * afternoon away from a header nobody can read. What each one looks like is in
 * globals.css, keyed by these names; `src/lib/theme.ts` is only what they are called.
 *
 * None of them is green, red or amber. Those three already say something here — added,
 * about to be deleted, overdue — and a home dressed in one would be saying it on every
 * screen.
 */
enum HomeTheme {
  SLATE
  OCEAN
  INDIGO
  VIOLET
  PLUM
  SAND
}

model Home {
  id        String    @id @default(cuid())
  name      String
  address   String?
  /// The household's own picture, shown in the header and on the dashboard.
  photoId   String?
  /// The colour this home is dressed in, chosen by the people who run it.
  theme     HomeTheme @default(SLATE)
  createdAt DateTime  @default(now())

  /// Everybody who belongs to this home, and what each of them may do in it.
  members          HomeMember[]
  /**
   * The people looking at this home right now. SetNull rather than Cascade: deleting a
   * home empties the households of the people who were in it, it does not delete them.
   */
  activeFor        User[]           @relation("ActiveHome")
  invites          Invite[]
  lists            List[]
  tasks            Task[]
  recipes          Recipe[]
  recipeCategories RecipeCategory[]
  /// Every picture filed under this home, whatever it is attached to.
  photos           Photo[]          @relation("PhotoHome")
  photo            Photo?           @relation("HomePhoto", fields: [photoId], references: [id], onDelete: SetNull)
}

/**
 * One person, who may belong to any number of homes.
 *
 * Which homes those are is `memberships`. `activeHomeId` is only which of them they
 * are looking at now — a pointer into that set, never the set itself.
 *
 * So what somebody may reach is answered from `memberships`; asking `activeHomeId`
 * would answer "the one home they happen to have open", which is a different question
 * wearing the same clothes.
 */
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         PlatformRole @default(USER)
  /**
   * The home being looked at now, or null for somebody who is in no home at all. Held
   * loosely: a membership can be revoked while its owner is looking elsewhere, so this
   * is read as a preference and checked against `memberships` rather than trusted.
   */
  activeHomeId String?
  createdAt    DateTime     @default(now())

  activeHome        Home?              @relation("ActiveHome", fields: [activeHomeId], references: [id], onDelete: SetNull)
  memberships       HomeMember[]
  pushSubscriptions PushSubscription[]
  favoriteLists     ListFavorite[]
  lists             List[]
  tasks             Task[]             @relation("TaskCreatedBy")
  tasksAssigned     Task[]             @relation("TaskAssignee")
  recipes           Recipe[]
  invitesCreated    Invite[]           @relation("InviteCreatedBy")

  @@index([activeHomeId])
}

/**
 * One person in one home, and what they may do there.
 *
 * This is the row that says somebody is part of a household, so a person in three
 * homes has three of them and is an admin in exactly the ones that say so. It is what
 * homeDb scopes when a page asks who is in a home — User is not home-scoped any more,
 * because a user is not in one home.
 *
 * Cascaded from both sides: deleting the account takes its memberships with it, and
 * deleting a home takes them too. Either way what goes is the belonging, not the
 * account, and not the lists, tasks and recipes that person wrote in other homes.
 */
model HomeMember {
  userId    String
  homeId    String
  role      MemberRole @default(USER)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  // One membership per person per home, and the lookup that asks who is in a home.
  @@id([userId, homeId])
  @@index([homeId])
}

model Invite {
  id          String     @id @default(cuid())
  email       String
  homeId      String
  role        MemberRole @default(USER)
  codeHash    String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdAt   DateTime   @default(now())

  home      Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy User @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([homeId])
  @@index([email])
}

model List {
  id           String   @id @default(cuid())
  homeId       String
  title        String
  /// Whether items on this list carry a quantity. Chosen when the list is made: a
  /// shopping list wants "2 milk", a to-do list does not.
  trackAmounts Boolean  @default(false)
  photoId      String?
  createdById  String
  createdAt    DateTime @default(now())

  home      Home           @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  photo     Photo?         @relation(fields: [photoId], references: [id], onDelete: SetNull)
  items     ListItem[]
  favorites ListFavorite[]

  @@index([homeId])
}

/**
 * One person's shortcut to one list. Favourites are personal rather than shared: two
 * people in the same home keep different ones, and each dashboard shows its own.
 * It carries no homeId, so homeDb cannot scope it — like ListItem it is reached through
 * its list, which is what carries the home. Pages read it as an include on a list query
 * they already made through homeDb; a lint rule stops them reaching it directly.
 */
model ListFavorite {
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  // One star per person per list, and the lookup the dashboard makes.
  @@id([userId, listId])
  @@index([listId])
}

model ListItem {
  id       String  @id @default(cuid())
  listId   String
  text     String
  amount   Int     @default(1)
  done     Boolean @default(false)
  position Int     @default(0)

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
}

/**
 * Something the household has to do: once, or over and over.
 *
 * Which of the two it is, is `intervalDays`. A number is the recurring kind — marking
 * it done books it in again that many days out — and null is a one-off, which is
 * finished once it has been done and stays that way.
 *
 * A one-off is therefore finished when `lastCompletedAt` is set, and a recurring task
 * never is: see lib/tasks.ts, where that pair of columns is read in one place rather
 * than spelled out at every query.
 */
model Task {
  id              String    @id @default(cuid())
  homeId          String
  title           String
  notes           String?
  /// How many days between repeats, or null for a one-off.
  intervalDays    Int?
  nextDueAt       DateTime
  lastCompletedAt DateTime?
  lastNotifiedAt  DateTime?
  createdById     String
  /**
   * Who the task is for, or null for the whole household. Null is not "nobody": an
   * unassigned task belongs to everyone, and everyone is reminded about it. Naming
   * somebody narrows the reminder to them, it does not change who may complete it.
   */
  assigneeId      String?
  photoId         String?
  createdAt       DateTime  @default(now())

  home      Home   @relation(fields: [homeId], references: [id], onDelete: Cascade)
  photo     Photo? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdBy User   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  /**
   * SetNull rather than Cascade, unlike createdBy: removing a member must not take the
   * household's tasks with them. The task falls back to being everybody's, which is
   * where it started.
   */
  assignee  User?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([homeId])
  @@index([nextDueAt])
  // The dashboard and the task list both ask for one home's tasks in due order.
  @@index([homeId, nextDueAt])
}

model Recipe {
  id           String   @id @default(cuid())
  homeId       String
  title        String
  description  String?
  ingredients  String   @default("")
  instructions String   @default("")
  videoUrl     String?
  photoId      String?
  createdById  String
  createdAt    DateTime @default(now())

  home       Home                 @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdBy  User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  photo      Photo?               @relation(fields: [photoId], references: [id], onDelete: SetNull)
  /// Every heading this recipe is filed under; at least one, often more.
  categories RecipeCategoryLink[]

  @@index([homeId])
}

/**
 * A heading a home files its recipes under, maintained by that home's admins.
 * Categories are shared rather than personal — unlike ListFavorite, every cook in the
 * house sees the same ones — and a recipe carries as many of them as it belongs under.
 * What the headings mean is each household's business: "Weeknight" is whatever they
 * decided it is.
 */
model RecipeCategory {
  id        String   @id @default(cuid())
  homeId    String
  name      String
  createdAt DateTime @default(now())

  home    Home                 @relation(fields: [homeId], references: [id], onDelete: Cascade)
  recipes RecipeCategoryLink[]

  // Two categories with one name in one home would be indistinguishable in the picker.
  // Separate homes name theirs freely.
  @@unique([homeId, name])
  @@index([homeId])
}

/**
 * One recipe filed under one heading. A recipe has at least one of these and may have
 * several: a lasagne is both "Weeknight" and "Italian", and a household that had to
 * choose between them would file it under whichever it thought of first and then fail
 * to find it under the other.
 * Like ListFavorite it carries no homeId, so homeDb cannot scope it — it is reached
 * through the recipe, which is what carries the home. Actions write it nested inside a
 * recipe they have already checked, and pages read it as an include on a recipe query
 * made through homeDb; a lint rule stops them reaching it directly.
 * NoAction on the category, and the difference from Restrict matters. Postgres checks
 * Restrict the moment the category row goes, which would make deleting a whole home
 * fail: the cascade removes its categories, its recipes and these rows in one
 * statement, in no fixed order. NoAction is checked once the statement is finished, by
 * which point all of them are gone. A category still holding recipes is refused either
 * way, which is the point of having the constraint.
 */
model RecipeCategoryLink {
  recipeId   String
  categoryId String

  recipe   Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  category RecipeCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction)

  // One row per pairing, and the lookup that asks what is filed under a category.
  @@id([recipeId, categoryId])
  @@index([categoryId])
}

/**
 * A picture belonging to one home: the household's own, or one attached to a list, a
 * task or a recipe.
 * The bytes live in the database rather than in object storage. A household's whole
 * collection is measured in megabytes, and keeping it here means there is no second
 * service to hold credentials for, nothing to keep in step when a row is deleted, and
 * the local and deployed apps behave identically.
 * Two sizes are stored, because the two ways a picture is shown want very different
 * amounts of data: a recipe page wants the whole thing, while a directory of twenty
 * cards wants twenty postage stamps. Both are written once, at upload, so displaying
 * either is a single read.
 * Every picture is downscaled in the browser before it is sent — see lib/downscale.ts
 * — and what arrives is checked again here against the same limits. A phone's twelve
 * megapixel photo never travels, and a caller that skips the browser is refused.
 */
model Photo {
  id          String   @id @default(cuid())
  homeId      String
  contentType String
  width       Int
  height      Int
  bytes       Bytes
  thumbWidth  Int
  thumbHeight Int
  thumbBytes  Bytes
  createdAt   DateTime @default(now())

  home Home @relation("PhotoHome", fields: [homeId], references: [id], onDelete: Cascade)

  /**
   * What is using this picture. Nothing reads these to draw a page — a page has the
   * photoId already — but they are how an upload nobody finished can be recognised as
   * unreferenced and swept up.
   * SetNull on each side, never Restrict: deleting a home removes its pictures and the
   * things holding them in one statement, and Postgres checks Restrict the instant the
   * referenced row goes. SetNull has no such ordering to get wrong.
   */
  homes   Home[]          @relation("HomePhoto")
  lists   List[]
  tasks   Task[]
  recipes Recipe[]

  @@index([homeId])
  // The sweep for unreferenced uploads asks for one home's oldest pictures.
  @@index([homeId, createdAt])
}

/**
 * Failed sign-in and invite attempts, used only for throttling.
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

/**
 * One row per reminder run. Without this a cron that silently stops running looks
 * exactly like a week with nothing due, and nobody finds out.
 */
model CronRun {
  id                String    @id @default(cuid())
  job               String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  ok                Boolean   @default(false)
  tasksDue          Int       @default(0)
  notificationsSent Int       @default(0)
  error             String?

  @@index([job, startedAt])
}

/**
 * Database calls that took longer than the threshold. Only the slow ones are kept:
 * recording every query would make the metrics table the busiest one in the database.
 */
model SlowQuery {
  id         String   @id @default(cuid())
  model      String?
  operation  String
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
